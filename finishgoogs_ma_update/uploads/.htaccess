# โฟลเดอร์รูปภาพ: เปิดให้ดูไฟล์ได้ แต่ห้ามรันสคริปต์ทุกชนิด
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5
RemoveType .php .phtml .php3 .php4 .php5
<FilesMatch "\.(php|phtml|php[0-9])$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
