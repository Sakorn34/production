# secrets — ไม่มีไฟล์เหล่านี้ในโค้ดแล้ว (ย้ายไป D:\AppServ\secrets\production\) แต่กันไว้อีกชั้น
**/config.local.php
**/config.paths.php
**/*.secrets.php
**/sftp.json
**/.vscode/
.env
Appscript*.txt

# cache ของเครื่องมือภายนอก — wrangler-account.json มี Cloudflare account id + อีเมล
.wrangler/

# ไฟล์ร่าง/โน้ตงานออกแบบ ไม่ใช่โค้ดของโปรเจ็ค
ai_studio_code/

# ไฟล์ที่ generate/runtime ไม่ควร commit
**/uploads/*
!**/uploads/.htaccess
**/logs/*.log
*.log

# ฐานข้อมูล local/backup ที่ไม่ควรอยู่ใน repo
/_db_import_temp/
*.sql
*.sql.zip
**/db.db

# _archive — ไม่ track ใน git (เก็บ local)
/_archive/backups/
/_archive/.claude/

# ชุด deploy server (มีรหัส DB — อย่า commit)
/deploy/hostatom/
/deploy/release/
/deploy/.last-deploy.json
/deploy/.last-build.json
